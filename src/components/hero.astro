---
import { Image } from "astro:assets";
import hero from "~/assets/hero_portrait.jpg";
import type { NavItem } from "~/types";

const navItems: Array<NavItem> = [
  { title: "Services", url: "#services" },
  { title: "Guides", url: "#guides" },
  { title: "Music", url: "#music" },
  { title: "Contact", url: "#contact" },
];

const headline = "Robert Chandler";
const sub =
  "Trained in jazz and rock, rooted in contemporary Christian worship, and skilled in metalcore.";
---

<div class="bg-gray-900">
  <header id="hero-header" class="absolute inset-x-0 top-0 z-50">
    <nav
      class="flex items-center justify-between p-6 lg:px-8"
      aria-label="Global"
    >
      <div class="flex lg:flex-1">
        <a href="#hero-header" class="-m-1.5 p-1.5">
          <h1 class="sr-only">rochadrums</h1>
          <span class="font-extrabold text-white">rochadrums</span>
        </a>
      </div>
      <div class="hidden lg:flex lg:gap-x-12">
        {
          navItems.map(({ title, url }) => (
            <a href={url} class="font-semibold leading-6 text-white text-sm">
              {title}
            </a>
          ))
        }
      </div>
      <div class="hidden lg:flex lg:flex-1 lg:justify-end"></div>
    </nav>
  </header>

  <div class="relative isolate overflow-hidden py-16">
    <Image
      width={1080}
      src={hero}
      alt="Robert Chandler professional drummer portrait"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover blur-[2px] brightness-50"
    />

    <div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-56">
      <div class="text-center">
        <h1 class="font-bold tracking-tight text-white text-4xl sm:text-6xl">
          {headline}
        </h1>
        <p class="mt-6 leading-8 text-gray-300 text-lg">{sub}</p>
        <div class="mt-10 flex justify-center">
          <a
            href="#contact"
            class="rounded-full bg-bar-600 px-6 py-3 font-semibold text-white shadow-sm text-sm hover:bg-bar-500 hover:!text-white"
          >
            Get in touch
          </a>
        </div>
        <div class="mt-10 flex animate-bounce justify-center">
          <svg
            enable-background="new 0 0 26 26"
            height="26px"
            id="Layer_1"
            version="1.1"
            viewBox="0 0 26 26"
            width="26px"
            xml:space="preserve"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
          >
            <g>
              <polygon
                fill="#ACACAC"
                points="0.046,2.582 2.13,0.498 12.967,11.334 23.803,0.498 25.887,2.582 12.967,15.502  "
              ></polygon>
              <polygon
                fill="#FFFFFF"
                points="0.046,13.582 2.13,11.498 12.967,22.334 23.803,11.498 25.887,13.582 12.967,26.502  "
              ></polygon>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>
