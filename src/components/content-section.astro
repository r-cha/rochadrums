---
export interface Props {
  id: string;
  title: string;
}

const { title, id } = Astro.props;
const hasLead = Astro.slots.has("lead");
---

<section id={id} class="flex w-full scroll-mt-24 flex-col items-center gap-6">
  <h2
    class="text-center font-extrabold uppercase tracking-widest text-secondary text-sm"
  >
    {title}
  </h2>
  {
    hasLead && (
      <p class="max-w-2xl text-center font-bold text-offset text-2xl">
        <slot name="lead" />
      </p>
    )
  }
  <slot />
</section>
