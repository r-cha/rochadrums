---
import { Icon } from "astro-icon";
import type { FooterLink } from "~/types";
import { Image } from "astro:assets";
import hero from "~/assets/hero_landscape.jpg";

const widths = [450, 800, 1200];
const sizes = "100vw";

const links: Array<FooterLink> = [
  {
    url: "mailto:robert@rochadrums.com?subject=rochadrums request",
    description: "robert@rochadrums.com",
    icon: "mdi:email",
  },
  {
    url: "https://www.instagram.com/rochadrums/",
    description: "Instagram",
    icon: "mdi:instagram",
  },
  {
    url: "https://www.youtube.com/@rocha-drums",
    description: "Youtube",
    icon: "mdi:youtube",
  }, // TODO: replace with a link to concerto?
];
---

<footer
  id="contact"
  class="relative isolate flex flex-col items-center justify-center gap-6 overflow-hidden bg-gray-900 py-20 text-white"
>
  <Image
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    src={hero}
    alt="Robert playing some drums"
    widths={widths}
  />
  <h2 class="text-center font-bold text-2xl">Get in touch</h2>
  <ul class="flex gap-4">
    {
      links.map((link) => (
        <li>
          <a
            class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-current p-4"
            href={link.url}
          >
            <span class="sr-only">{link.description}</span>
            <Icon class="h-full" name={link.icon} />
          </a>
        </li>
      ))
    }
  </ul>
  <a
    class="font-semibold text-gray-300 hover:!text-white"
    href="mailto:robert@rochadrums.com?subject=rochadrums request"
  >
    robert@rochadrums.com
  </a>
</footer>
